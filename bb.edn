{:tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p])

  :init (do
          (def source-dirs ["src" "dev" "test" "notebooks"])

          (defn sh!
            "Run a command and stream stdout/stderr. Throws on non-zero."
            [& args]
            (let [res (apply p/shell {:inherit true} args)]
              (when-not (zero? (:exit res))
                (throw (ex-info (str "Command failed: " (pr-str args))
                         {:exit (:exit res)})))
              res))

          (defn ensure-dirs! []
            (doseq [d source-dirs]
              (when-not (fs/exists? d)
                (println "Missing required folder:" d)
                (System/exit 2))))

          ;; Always run tools using mise's pinned versions
          (defn mise! [& cmd]
            (apply sh! "mise" "exec" "--" cmd)))

  build
  {:doc "Build = format check + lint + test + clerk export"
   :task (do
           (run 'check)
           (run 'clerk-export))}

  fmt
  {:doc "Format code with cljstyle"
   :task (do
           (ensure-dirs!)
           (apply mise! "cljstyle" "fix" source-dirs))}

  style-check
  {:doc "Check formatting/style with cljstyle (src + test)"
   :task (do
           (ensure-dirs!)
           (mise! "cljstyle" "check" "src" "test"))}

  style-check-all
  {:doc "Check formatting/style with cljstyle (all directories)"
   :task (do
           (ensure-dirs!)
           (apply mise! "cljstyle" "check" source-dirs))}

  lint
  {:doc "Lint production code (src + test) with clj-kondo"
   :task (do
           (ensure-dirs!)
           (mise! "clj-kondo" "--lint" "src" "--lint" "test"))}

  lint-all
  {:doc "Lint everything (src + test + dev + notebooks)"
   :task (do
           (ensure-dirs!)
           (mise! "clj-kondo" "--lint" "src"
             "--lint" "test"
             "--lint" "dev"
             "--lint" "notebooks"))}

  test
  {:doc "Run tests (kaocha)"
   :task (do
           (ensure-dirs!)
           (mise! "clojure" "-M:test"))}

  clerk
  {:doc "Start Clerk (watch notebooks/)"
   :task (do
           (ensure-dirs!)
           (mise! "clojure" "-M:dev" "-m" "clerk"))}

  clerk-export
  {:doc "Export notebooks to static HTML in public/"
   :task (do
           (ensure-dirs!)
           (fs/delete-tree "public")
           (fs/create-dirs "public")
           (mise! "clojure" "-M:dev" "-m" "export-clerk"))}

  splint
  {:doc "Check for idiomatic Clojure style with Splint (src + test)"
   :task (do
           (ensure-dirs!)
           (mise! "clojure" "-M:splint" "src" "test"))}

  splint-all
  {:doc "Check idiomatic style with Splint (all directories)"
   :task (do
           (ensure-dirs!)
           (apply mise! "clojure" "-M:splint" source-dirs))}

  check
  {:doc "Run the full quality gate"
   :task (do
           (run 'style-check)
           (run 'lint)
           (run 'splint)
           (run 'test))}

  clean
  {:doc "Clean build artifacts and caches"
   :task (do
           (doseq [dir ["public" ".cpcache" "target" ".clj-kondo/.cache"]]
             (when (fs/exists? dir)
               (println "Removing:" dir)
               (fs/delete-tree dir))))}

  dev-repl
  {:doc "Start a REPL with dev dependencies"
   :task (do
           (ensure-dirs!)
           (mise! "clojure" "-M:dev"))}}}